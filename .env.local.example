# ── 클라이언트(브라우저) Firebase 설정: 공개되어도 되는 값 ──
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정에서 복사
# (App Hosting 배포 시에는 FIREBASE_WEBAPP_CONFIG로 자동 주입되므로 따로 넣지 않아도 됨)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 서버 전용 값: 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것 ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 로컬 개발 시 Admin SDK가 사용할 프로젝트/버킷
# (인증은 `gcloud auth application-default login` 또는 GOOGLE_APPLICATION_CREDENTIALS 로)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# 접근 제한(선택): 쉼표 구분
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
